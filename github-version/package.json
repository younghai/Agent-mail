{
  "name": "@agent-mail/release",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @agent-mail/client build",
    "dev": "scripts/start-local.sh",
    "start": "scripts/start-local.sh",
    "test": "pnpm --filter agentic-inbox-mail-server test",
    "typecheck": "pnpm --filter @agent-mail/client typecheck",
    "dev:api": "pnpm --dir mail-server run dev",
    "dev:client": "pnpm --dir client run dev --host 0.0.0.0 --port 5000"
  }
}
