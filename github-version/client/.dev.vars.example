# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Sentry error monitoring (optional — omit to disable Sentry in local dev).
# In production inject via: wrangler secret put SENTRY_DSN
SENTRY_DSN=

# Slack alert webhook (optional — omit to disable Slack alerts in local dev).
# In production inject via: wrangler secret put SLACK_ALERT_WEBHOOK_URL
SLACK_ALERT_WEBHOOK_URL=
