{
	"name": "@agent-mail/client",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"cloudflare": {
		"label": "Agentic Inbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "vite --config vite.config.standalone.ts",
		"dev:standalone": "vite --config vite.config.standalone.ts",
		"preview": "pnpm run build && vite preview",
		"services:up": "docker-compose up --build",
		"services:down": "docker-compose down",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"test:integration": "vitest run --config vitest.config.ts",
		"typecheck": "react-router typegen && tsc -b",
		"deploy:tail-consumer": "wrangler deploy --config wrangler.tail-consumer.jsonc"
	},
	"dependencies": {
		"@cloudflare/ai-chat": "^0.1.9",
		"@cloudflare/kumo": "^1.19.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@phosphor-icons/react": "^2.1.10",
		"@sentry/cloudflare": "^10.78.0",
		"@sentry/react": "^10.78.0",
		"@tanstack/react-query": "^5.105.3",
		"@tiptap/extension-color": "3.32.2",
		"@tiptap/extension-highlight": "3.32.2",
		"@tiptap/extension-image": "3.32.2",
		"@tiptap/extension-link": "3.32.2",
		"@tiptap/extension-text-align": "3.32.2",
		"@tiptap/extension-text-style": "3.32.2",
		"@tiptap/extension-underline": "3.32.2",
		"@tiptap/react": "3.32.2",
		"@tiptap/starter-kit": "3.32.2",
		"agents": "^0.7.9",
		"ai": "^6.0.322",
		"dompurify": "^3.4.17",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.16",
		"isbot": "^5.2.2",
		"jose": "^6.2.15",
		"postal-mime": "^2.7.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-router": "^7.18.5",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^3.3.1",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@cloudflare/workers-types": "^5.20261103.1",
		"@react-router/dev": "^7.18.5",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^6.4.5",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.12",
		"wrangler": "^4.156.2"
	}
}
