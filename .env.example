# Replit settings reference only. No real credentials are included.
# Configure required values using Replit Secrets / Production app secrets.
# The application does not automatically load this root example file.

# Use the existing environment's PostgreSQL connection; never commit its value.
DATABASE_URL=

# Independent, newly generated secret; at least 32 characters.
SESSION_SECRET=

# Separate administrator password; 16 to 1024 characters.
INBOX_ADMIN_PASSWORD=

# Only one web service is exposed in production.
PORT=5000

# Optional durable attachment storage. Required before real attachment use.
# The endpoint must be HTTPS. Do not use workspace-local MinIO in production.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# No SMTP or real AI credentials are required for the current campaign scenarios.
