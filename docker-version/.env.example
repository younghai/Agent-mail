# v1-present Agent Mail — Docker Compose environment variables
#
# This file configures the independent mail-server + ai-agent microservices.
# Copy to .env and fill in secrets before running `docker compose up --build`.

# Database
POSTGRES_PASSWORD=agentic-local-change-me
DATABASE_URL=postgresql://agentic:agentic-local-change-me@localhost:5432/agentic_inbox
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Redis
REDIS_URL=redis://localhost:6379

# AI Agent
APP_ENV=local
OPENAI_API_KEY=sk-your-openai-key
AI_MODEL=gpt-4o-mini
AI_MODEL_INPUT_USD_PER_1M=0.15
AI_MODEL_OUTPUT_USD_PER_1M=0.60
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONTEXT_CHARS=12000
AI_AUTO_DRAFT_MAX_ATTEMPTS=2
AI_DLQ_STREAM=email-events-dlq

# Mail Server
AI_AGENT_URL=http://localhost:5100
WEBHOOK_SECRET=webhook-secret-change-me
PORT=5174
CLIENT_PORT=5000
AI_AGENT_PORT=5100
DEFAULT_MAILBOX_NAME=VTStirelab
LOCAL_SERVICE_TOKEN=local-dev-token-change-me
VITE_LOCAL_SERVICE_TOKEN=local-dev-token-change-me
ADMIN_EMAILS=local-admin@example.local
APP_DOMAINS=bizmatrixx.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RUN_MIGRATIONS=false

# Object Storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minio-local-change-me
S3_BUCKET=agentic-inbox
