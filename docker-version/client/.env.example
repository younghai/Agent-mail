# Local helper services environment variables
#
# These services are not the primary Cloudflare Workers production backend.
# They are a local/internal assistant layer for importing existing email data,
# categorizing requests by owner/company/issue/thread, drafting replies, and
# tracking mail-derived tasks/projects on a timeline.

# Database
POSTGRES_PASSWORD=agentic-local-change-me
DATABASE_URL=postgresql://agentic:agentic-local-change-me@localhost:5432/agentic_inbox
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Redis
REDIS_URL=redis://localhost:6379

# AI Agent
OPENAI_API_KEY=sk-your-openai-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONTEXT_CHARS=12000

# Mail Server
AI_AGENT_URL=http://localhost:5100
WEBHOOK_SECRET=webhook-secret-change-me
PORT=5174
CLIENT_PORT=5000
AI_AGENT_PORT=5100
DEFAULT_MAILBOX_NAME=VTStirelab
LOCAL_SERVICE_TOKEN=local-dev-token-change-me
VITE_LOCAL_SERVICE_TOKEN=local-dev-token-change-me
VITE_API_BASE_URL=http://localhost:5174
VITE_ADMIN_DEMO_DATA=false
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RUN_MIGRATIONS=false

# Object Storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minio-local-change-me
S3_BUCKET=agentic-inbox
